# ── CyberBlack AI-agent MAX / MAX OS: Git Ignore ─────────────────────────────
# Automatically generated runtime artifacts, local databases, secrets, and caches.
# A fresh clone initializes clean defaults and auto-creates necessary local state.

# ── Secrets & Credentials ─────────────────────────────────────────────────────
config/api_keys.json
config/certs/
config/whatsapp_web/
**/token*.json
**/client_secret*.json
*credentials*.json
.env
.env.*
!.env.example

# ── Persistent Storage & Local Databases ──────────────────────────────────────
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
max_state.db
memory/*.db
core/max_infra/*.db
memory/notes.json
memory/api_budget.json
memory/budget_tracking.json
memory/backups/*
!memory/backups/.gitkeep
eval_results_*.json

# ── Autonomous Snapshots & Rollback Data ──────────────────────────────────────
.snapshots/
temp_laya/
scratch/
.quarantine/
.agents/

# ── Python Build & Packaging ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# ── Testing, Linting & Code Coverage ──────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ── Virtual Environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Editors & OS Metadata ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Runtime Output & Logs ─────────────────────────────────────────────────────
*.log
logs/*
!logs/.gitkeep
notes/*
!notes/.gitkeep
downloads/*
!downloads/.gitkeep
screenshots/*
!screenshots/.gitkeep
