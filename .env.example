# Environment Variables for FRIDAY AI Operating Layer
# Copy to .env and insert your real API keys

# Primary Cloud Reasoning Brain
GEMINI_API_KEY=""

# Fallback Cloud Reasoning Brain
ANTHROPIC_API_KEY=""

# Optional Secondary Fallback
OPENAI_API_KEY=""

# Identity and Tone
ASSISTANT_NAME="FRIDAY"
USER_TITLE=""

# Model Routing & Budget
DEFAULT_LLM_PROVIDER="gemini"
FALLBACK_LLM_PROVIDER="anthropic"
GEMINI_MODEL="gemini-2.0-flash"
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
MONTHLY_BUDGET_USD=25.0

# Local Hardware & Voice Pipeline
HARDWARE_TARGET="rtx3050"
MAX_GPU_MODELS_MB=3000
WAKE_WORD_MODEL="hey_jarvis"
STT_MODEL="small"
STT_COMPUTE_TYPE="int8"
TTS_ENGINE="piper"
TTS_VOICE="en_GB-alan-medium"

# Operational
LOG_LEVEL="INFO"
DRY_RUN=false
