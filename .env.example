# ==============================================================================
# MAX OS — Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your keys.
# ==============================================================================

# --- AI & LLM PROVIDER API KEYS ---
# Google Gemini API Key (e.g., AIzaSy...)
GEMINI_API_KEY=

# Anthropic Claude API Key (e.g., sk-ant-api03-...)
ANTHROPIC_API_KEY=

# OpenAI API Key (e.g., sk-proj-...)
OPENAI_API_KEY=

# Local Ollama Server URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma:7b

# --- VOICE & SPEECH SYNTHESIS (TTS/STT) ---
# ElevenLabs API Key for ultra-realistic voice generation (Starts with 'sk_...')
# Create your key at https://elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- DEVELOPER & DEPLOYMENT INTEGRATIONS ---
# GitHub Personal Access Token (for DeployAgent repository & CI/CD sync)
GITHUB_PAT=

# --- SERVER & NETWORKING ---
MAX_SERVER_HOST=0.0.0.0
MAX_SERVER_PORT=8000
MAX_ENV=development
MAX_LOG_LEVEL=INFO

# --- SYSTEM & DATABASE PATHS ---
STATE_DB_PATH=max_state.db
MAX_VAULT_DIR=~/.max_os
